{
  "name": "agentwares-libs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "description": "Shared libraries behind the agentwares portfolio: @agentwares/mcp-kit (MCP servers over stdio and Streamable HTTP), @agentwares/notify (email, Slack, Discord, signed webhooks), @agentwares/x402 (402 Payment Required) and @agentwares/web-bot-auth (Ed25519 request signing for Cloudflare's Verified Bots).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentwares/libs"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "pretest": "pnpm run build",
    "pretypecheck": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
